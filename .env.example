# Base URL of the existing CocoInbox REST API (no trailing slash)
COCOINBOX_API_URL=http://localhost:4000

# Public MCP site (login form + version page)
MCP_PUBLIC_URL=https://cocoinbox-mcp.vercel.app

# HMAC secret for browser-form auth codes (set in Vercel too)
MCP_AUTH_SECRET=change-me-in-production

# Optional: pre-set a Bearer token instead of calling login
# COCOINBOX_TOKEN=

# HTTP transport only (src/http.ts)
# MCP_HTTP_PORT=3100
# MCP_HTTP_HOST=127.0.0.1
