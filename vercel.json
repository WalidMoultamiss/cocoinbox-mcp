{
  "version": 2,
  "builds": [
    { "src": "api/**/*.js", "use": "@vercel/node" },
    { "src": "api/**/*.ts", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "^/$", "dest": "/api/index.js" },
    { "src": "^/health$", "dest": "/api/health.js" },
    { "src": "^/version$", "dest": "/api/version.js" },
    { "src": "^/login$", "dest": "/api/login.js" },
    { "src": "^/authorize$", "dest": "/api/oauth-authorize.js" },
    { "src": "^/token$", "dest": "/api/oauth-token.js" },
    { "src": "^/register$", "dest": "/api/oauth-register.js" },
    { "src": "^/oauth/register$", "dest": "/api/oauth-register.js" },
    { "src": "^/oauth/authorize$", "dest": "/api/oauth-authorize.js" },
    { "src": "^/oauth/token$", "dest": "/api/oauth-token.js" },
    { "src": "^/\\.well-known/oauth-protected-resource$", "dest": "/api/oauth-protected-resource.js" },
    { "src": "^/\\.well-known/oauth-protected-resource/mcp$", "dest": "/api/oauth-protected-resource.js" },
    { "src": "^/\\.well-known/oauth-authorization-server$", "dest": "/api/oauth-authorization-server.js" },
    { "src": "^/\\.well-known/openid-configuration$", "dest": "/api/oauth-authorization-server.js" },
    { "src": "^/icon\\.png$", "dest": "/api/icon.js" },
    { "src": "^/favicon\\.ico$", "dest": "/api/favicon.js" },
    { "src": "^/favicon\\.png$", "dest": "/api/favicon.js" },
    { "src": "^/apple-touch-icon\\.png$", "dest": "/api/apple-touch-icon.js" },
    { "src": "^/site\\.webmanifest$", "dest": "/api/manifest.js" },
    { "src": "^/manifest\\.webmanifest$", "dest": "/api/manifest.js" },
    { "src": "^/api/auth-form$", "dest": "/api/auth-form.js" },
    { "src": "^/mcp$", "dest": "/api/mcp.ts" }
  ]
}
